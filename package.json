{
	"name": "headlesstools",
	"description": "MCP-first SaaS tools for AI agents",
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.10.3",
		"@modelcontextprotocol/server": "2.0.0",
		"agents": "^0.21.0",
		"drizzle-orm": "^0.45.2",
		"hono": "4.13.4",
		"nanoid": "5.1.16",
		"postal-mime": "^3.0.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"shiki": "^4.4.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.11",
		"wrangler": "4.125.0"
	},
	"private": true,
	"pnpm": {
		"overrides": {
			"esbuild@<=0.24.2": "0.25.12"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	},
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "npm run build && wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply headlesstools-db",
		"db:migrate:remote": "wrangler d1 migrations apply headlesstools-db --remote",
		"db:studio": "drizzle-kit studio"
	},
	"type": "module"
}
